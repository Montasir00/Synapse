rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: tasks
    // Fields: title, description, priority, status, due_date, totalTimeSpent, createdAt
    //
    // Collection: transactions
    // Fields: date, category, merchant, amount, type, status, description, createdAt
    //
    // Collection: budgets
    // Fields: category, monthly_limit, updatedAt
    //
    // Collection: exercises
    // Fields: title, category, date, duration, intensity, createdAt
    //
    // Collection: crypto_holdings
    // Fields: asset, amount, avg_buy_price, last_updated
    //
    // Collection: crypto_trades
    // Fields: date, asset, type, amount, price, profit_loss, createdAt
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Strict ownership check: UID must match request.auth.uid
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Deep ownership check for documents containing a 'uid' field
    function isDocOwned(doc) {
      return isAuthenticated() && (doc == null || doc.data.uid == request.auth.uid);
    }

    // ===============================================================
    // Global Data Modules
    // ===============================================================

    // Fail-Safe: No access by default
    match /{path=**} {
      allow read, write: if false;
    }

    match /tasks/{taskId} {
      allow read, write: if isDocOwned(resource) || isDocOwned(request.resource);
    }

    match /transactions/{transactionId} {
      allow read, write: if isDocOwned(resource) || isDocOwned(request.resource);
    }

    match /loans/{loanId} {
      allow read, write: if isDocOwned(resource) || isDocOwned(request.resource);
    }

    match /budgets/{budgetId} {
      allow read, write: if isDocOwned(resource) || isDocOwned(request.resource);
    }

    match /exercises/{exerciseId} {
      allow read, write: if isDocOwned(resource) || isDocOwned(request.resource);
    }

    match /tradeNotes/{noteId} {
      allow read, write: if isDocOwned(resource) || isDocOwned(request.resource);
    }

    match /notes/{noteId} {
      allow read, write: if isDocOwned(resource) || isDocOwned(request.resource);
    }

    match /app_settings/{settingId} {
      allow read, write: if isDocOwned(resource) || isDocOwned(request.resource);
    }

    match /trade_journals/{journalId} {
      allow read, write: if isDocOwned(resource) || isDocOwned(request.resource);
    }

    match /user_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ===============================================================
    // Precision Trading Buffers (Isolated by UID)
    // ===============================================================

    match /binance_trades/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    match /binance_positions/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    match /binance_metrics/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Explicit top-level metrics doc used by tradePersistenceService
    match /binance_metrics/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /user_trades_sync/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /user_secrets/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /binance_balances/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Explicit top-level balances doc used by tradePersistenceService
    match /binance_balances/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
